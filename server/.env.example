# Server
PORT=3001
HOST=0.0.0.0

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Clerk server-side token verification (required for account favorites)
# CLERK_SECRET_KEY=sk_test_...

# Neon Postgres
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Neo4j AuraDB (used for recommendations; set all three together)
# Copy the URI, username, and generated password from Aura's Connect > Drivers.
# AURA_INSTANCENAME is only a display name; the API does not use it.
# NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<password>

# Upstash Redis (when provisioned)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
