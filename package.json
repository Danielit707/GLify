{
  "name": "glify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "dev:all": "concurrently -k \"npm run dev\" \"npm run dev:server\"",
    "db:setup": "npm --prefix server run db:setup",
    "build": "tsc -b && vite build",
    "build:server": "npm --prefix server run build",
    "typecheck:server": "npm --prefix server run typecheck",
    "db:import-anilist": "npm --prefix server run db:import-anilist --",
    "db:curate-anilist": "npm --prefix server run db:curate-anilist --",
    "db:seed-graph": "npm --prefix server run db:seed-graph",
    "db:filter-yuri": "npm --prefix server run db:filter-yuri",
    "preview": "vite preview"
  },
  "dependencies": {
    "@clerk/react": "^6.17.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
